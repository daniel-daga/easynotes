/target
/.env
/.env.*.local
**/*.rs.bk
.DS_Store

# Flutter / Dart
/app/.dart_tool/
/app/build/
/app/.flutter-plugins*
/app/web/pkg/
/app/rust_builder/cargokit/build_tool/.dart_tool/

# The smoke test and the browser benchmark fetch `playwright-core` beside
# themselves rather than adding a package manifest to a repository that has no
# JavaScript in it.
/tools/web-smoke/node_modules/
/tools/web-smoke/package*.json
/tools/web-bench/node_modules/
/tools/web-bench/package*.json

# Gradle writes here even though the build directory is redirected to app/build.
/app/android/build/

# IntelliJ/Android Studio project files. Deliberately not shared: the Dart SDK
# library records an absolute path to whichever machine set it up, which is
# wrong for CI and for a cloud session, and the run configurations carry a
# developer's own relay address.
/.idea/
