# Copy to .env and replace the example values. Use a long random hex password so it
# can be placed safely in DATABASE_URL without URL escaping.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret

# Exact browser origin(s) of the app, comma separated, with scheme and no path.
# For native-only clients, use the relay's own HTTPS origin.
RELAY_ALLOWED_ORIGINS=https://notes.example.net

# Base64url-encoded 32-byte Ed25519 seed. Keep this stable and secret across
# relay restarts and instances; generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
RELAY_TOKEN_SIGNING_KEY=replace-with-base64url-encoded-32-byte-key

# Who may write to this relay. A base64url 32-byte key you give to the people
# you let in, generated the same way as the signing key above (a different
# one), or `open` to let anyone who finds the hostname write here. Several keys,
# comma separated, while you move everyone from an old one to a new one.
RELAY_ACCESS_KEYS=replace-with-another-base64url-encoded-32-byte-key

# Optional. Bytes one client address may write at once (empty means 200 MiB),
# and in an hour (empty means 200 MiB; `off` means no limit): notes and
# attachments together.
RELAY_WRITE_BURST=
RELAY_WRITE_PER_HOUR=

# Optional. Bytes every note together may hold before the relay stops taking
# new notes (existing notes keep working). Empty means 16 GiB; `off` means no
# ceiling.
RELAY_STORAGE_CEILING=

# Optional. Bytes one note's attachments may hold (empty means 1 GiB), and
# bytes every note's attachments may hold together (empty means 64 GiB; `off`
# means no ceiling). A removed attachment's bytes are deleted about a week
# after a compaction stops listing them (ADR 0027 §5).
RELAY_MEDIA_PER_NOTE=
RELAY_MEDIA_CEILING=

# Optional. The subnet of the containers' network (empty means 172.30.87.0/24).
# The relay trusts X-Forwarded-For only from this range, which is where DSM's
# reverse proxy reaches it from. Change it only if the NAS already uses that
# range for something else.
RELAY_NETWORK=

# Optional. The port on the NAS's loopback where the relay's Prometheus metrics
# are published (empty means 19090).
RELAY_METRICS_PORT=

# Persistent database files and attachment bytes will live here on the NAS.
NAS_DATA_DIR=/volume1/docker/easynotes-data
