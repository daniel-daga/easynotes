# Copy to .env and replace the example values. Use a long random hex password so it
# can be placed safely in DATABASE_URL without URL escaping.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret

# Exact browser origin(s) of the app, comma separated, with scheme and no path.
# For native-only clients, use the relay's own HTTPS origin.
RELAY_ALLOWED_ORIGINS=https://notes.example.net

# Base64url-encoded 32-byte Ed25519 seed. Keep this stable and secret across
# relay restarts and instances; generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
RELAY_TOKEN_SIGNING_KEY=replace-with-base64url-encoded-32-byte-key

# Optional. Bytes every note together may hold before the relay stops taking
# new notes (existing notes keep working). Empty means 16 GiB; `off` means no
# ceiling.
RELAY_STORAGE_CEILING=

# Persistent database files will live here on the NAS.
NAS_DATA_DIR=/volume1/docker/easynotes-data
